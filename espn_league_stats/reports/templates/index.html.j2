<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
{% if mobile_test %}<meta name="viewport" content="width=device-width, initial-scale=1">{% endif %}
<title>Guarcino League Stats</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<style>
  html { color-scheme: dark; }
  body { font-family: -apple-system, Segoe UI, Roboto, Arial, sans-serif; margin: 2rem; background: #0f172a; color: #e2e8f0; }
  h1, h2 { color: #f8fafc; }
  section { margin-bottom: 3rem; }
  table { border-collapse: collapse; width: 100%; margin-bottom: 1rem; font-size: 0.9rem; }
  th, td { border: 1px solid #334155; padding: 6px 10px; text-align: right; }
  th:first-child, td:first-child { text-align: left; }
  .cell-detail { display: block; font-size: 0.75em; color: #94a3b8; margin-top: 2px; font-weight: normal; }
  th { background: #1e293b; }
  tr.finish-gold > td { background: linear-gradient(180deg, #c9a34d 0%, #e9cf83 35%, #fff0b8 48%, #dbbb68 62%, #c9a34d 100%); color: #111827; font-weight: bold; }
  tr.finish-silver > td { background: linear-gradient(180deg, #a7adb5 0%, #d9dde2 35%, #f5f6f8 48%, #c6cbd2 62%, #a7adb5 100%); color: #111827; font-weight: bold; }
  tr.finish-gold > td::before, tr.finish-silver > td::before { color: #374151; }
  tr:nth-child(even) { background: #1e293b55; }
  table.sortable thead th { cursor: pointer; user-select: none; padding: 0; -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
  table.sortable thead th:hover { background: #334155; }
  table.sortable thead th:active { background: #475569; }
  table.sortable thead th button.sort-btn {
    all: unset;
    box-sizing: border-box;
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 6px 10px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .sort-indicator { font-size: 0.75em; opacity: 0.8; }
  #season-sort {
    color-scheme: dark;
    min-height: 44px; max-width: 100%; background-color: #1e293b; color: #e2e8f0;
    border: 1px solid #334155; border-radius: 6px; padding: 4px 28px 4px 8px; font-family: inherit; font-size: 0.9rem;
    -webkit-appearance: none; appearance: none; -webkit-text-fill-color: #e2e8f0; opacity: 1;
    background-image: linear-gradient(45deg, transparent 50%, #e2e8f0 50%), linear-gradient(135deg, #e2e8f0 50%, transparent 50%);
    background-position: right 14px center, right 8px center; background-size: 6px 6px, 6px 6px; background-repeat: no-repeat;
  }
  #season-sort option { background-color: #1e293b; color: #e2e8f0; }
  #season-sort optgroup { background-color: #1e293b; color: #94a3b8; border-top: 1px solid #334155; }
  #season-sort optgroup:first-of-type { border-top: none; }
  #season-sort-refresh { appearance: none; -webkit-appearance: none; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; border: 0; background: transparent; box-shadow: none; color: #38bdf8; cursor: pointer; font-family: inherit; }
  #season-sort-refresh .refresh-arrow { font-size: 26px; line-height: 28px; }
  #season-sort-refresh .refresh-label { font-size: 11px; line-height: 14px; }
  #season-sort-refresh:focus-visible { outline: 2px solid #38bdf8; outline-offset: 3px; }
  .charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; }
  .chart-box { background: #1e293b; border-radius: 8px; padding: 1rem; }
  canvas { max-height: 360px; }
  .h2h-table td { text-align: center; min-width: 70px; color: #111827; }
  .h2h-corner {
    position: relative; min-width: 110px; min-height: 48px; padding: 0 !important;
    background: linear-gradient(to top right, transparent calc(50% - 1px), #64748b calc(50% - 1px), #64748b calc(50% + 1px), transparent calc(50% + 1px));
  }
  .h2h-corner span { position: absolute; font-size: 0.75em; font-weight: normal; color: #e2e8f0; }
  .h2h-corner .h2h-corner-opponent { top: 4px; right: 8px; }
  .h2h-corner .h2h-corner-manager { bottom: 4px; left: 8px; }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid #334155; padding-bottom: 0.5rem; }
  .tab-radio { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .tab-button { display: inline-block; background: #1e293b; color: #e2e8f0; border: 1px solid #334155; border-radius: 6px; padding: 8px 14px; cursor: pointer; font-size: 0.9rem; }
  .tab-button:hover { background: #334155; }
  #tab-current-choice:checked ~ .tabs label[for="tab-current-choice"],
  #tab-alltime-choice:checked ~ .tabs label[for="tab-alltime-choice"],
  #tab-regular-choice:checked ~ .tabs label[for="tab-regular-choice"],
  #tab-playoffs-choice:checked ~ .tabs label[for="tab-playoffs-choice"],
  #tab-charts-choice:checked ~ .tabs label[for="tab-charts-choice"],
  #tab-h2h-choice:checked ~ .tabs label[for="tab-h2h-choice"],
  #tab-byseason-choice:checked ~ .tabs label[for="tab-byseason-choice"],
  #tab-misc-choice:checked ~ .tabs label[for="tab-misc-choice"] { background: #38bdf8; color: #0f172a; font-weight: bold; border-color: #38bdf8; }
  .tab-radio:focus-visible ~ .tabs label { outline: 2px solid #facc15; outline-offset: 2px; }
  .tab-panel { display: none; }
  #tab-current-choice:checked ~ .tab-panels #tab-current,
  #tab-alltime-choice:checked ~ .tab-panels #tab-alltime,
  #tab-regular-choice:checked ~ .tab-panels #tab-regular,
  #tab-playoffs-choice:checked ~ .tab-panels #tab-playoffs,
  #tab-charts-choice:checked ~ .tab-panels #tab-charts,
  #tab-h2h-choice:checked ~ .tab-panels #tab-h2h,
  #tab-byseason-choice:checked ~ .tab-panels #tab-byseason,
  #tab-misc-choice:checked ~ .tab-panels #tab-misc { display: block; }
{% if mobile_test %}
  .table-wrap { max-height: none; overflow: visible; }
  .tab-button { min-height: 28px; }
  @media (max-width: 700px) {
    body { margin: 16px; }
    h1 { font-size: 26px; }
    h2 { font-size: 20px; }
    .tabs { gap: 8px; }
    .charts-grid { grid-template-columns: minmax(0, 1fr); }
    .chart-box { min-width: 0; }
    table, tbody { display: block; width: 100%; }
    table thead { display: none; }
    table tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); border-bottom: 2px solid #64748b; padding: 12px 0; }
    table td { display: flex; flex-direction: column; text-align: left; border: 0; min-width: 0; overflow-wrap: anywhere; padding: 8px; }
    table td::before { content: attr(data-label); color: #94a3b8; font-size: 12px; margin-bottom: 4px; }
    table td:first-child { grid-column: 1 / -1; font-size: 18px; font-weight: bold; }
    .h2h-table tr { grid-template-columns: minmax(0, 1fr); }
    .h2h-table tr:first-child { display: none; }
    .h2h-table th { text-align: left; border: 0; padding: 12px 8px; }
    .h2h-table td { flex-direction: row; justify-content: space-between; text-align: left; min-width: 0; margin: 2px 0; }
    .h2h-table td::before { color: #111827; margin: 0; }
  }
{% endif %}
</style>
</head>
<body>
<noscript>
<div style="background:#fef3c7; color:#78350f; border:2px solid #d97706; border-radius:8px; padding:14px 18px; margin-bottom:1.5rem; font-size:0.95rem; line-height:1.5;">
  <strong>Sorting and tabs are disabled.</strong> This page needs JavaScript, which Mail's built-in
  preview doesn't run. Tap and hold this attachment (or tap the Share icon) and choose
  <strong>"Open in Safari"</strong> (or save it and open it from the Files app) to use the full
  interactive version.
</div>
</noscript>
<h1>Guarcino League Stats</h1>
<p>Current season: {{ current_year }}. Click any table header to sort by that column.</p>

<div class="tab-container">
<input class="tab-radio" type="radio" name="stats-tab" id="tab-current-choice" checked>
<input class="tab-radio" type="radio" name="stats-tab" id="tab-alltime-choice">
<input class="tab-radio" type="radio" name="stats-tab" id="tab-regular-choice">
<input class="tab-radio" type="radio" name="stats-tab" id="tab-playoffs-choice">
<input class="tab-radio" type="radio" name="stats-tab" id="tab-charts-choice">
<input class="tab-radio" type="radio" name="stats-tab" id="tab-h2h-choice">
<input class="tab-radio" type="radio" name="stats-tab" id="tab-byseason-choice">
<input class="tab-radio" type="radio" name="stats-tab" id="tab-misc-choice">
<nav class="tabs" role="tablist" aria-label="League statistics">
  <label class="tab-button" role="tab" for="tab-current-choice">Current Season</label>
  <label class="tab-button" role="tab" for="tab-alltime-choice">All-Time</label>
  <label class="tab-button" role="tab" for="tab-regular-choice">Regular Season</label>
  <label class="tab-button" role="tab" for="tab-playoffs-choice">Playoffs</label>
  <label class="tab-button" role="tab" for="tab-charts-choice">Charts</label>
  <label class="tab-button" role="tab" for="tab-h2h-choice">Head-to-Head</label>
  <label class="tab-button" role="tab" for="tab-byseason-choice">Results By Season</label>
  <label class="tab-button" role="tab" for="tab-misc-choice">Misc</label>
</nav>

<div class="tab-panels">
<div class="tab-panel" id="tab-current" role="tabpanel">
<section>
  <h2>Current Season Standings</h2>
  <div class="table-wrap">
  <table class="sortable">
    <thead>
      <tr><th>Manager</th><th>Team</th><th>W</th><th>L</th><th>T</th><th>PF</th><th>PA</th><th>Seed</th></tr>
    </thead>
    <tbody>
    {% for row in current_season %}
    <tr>
      <td>{{ row.manager_name }}</td><td>{{ row.team_name }}</td>
      <td>{{ row.wins }}</td><td>{{ row.losses }}</td><td>{{ row.ties }}</td>
      <td>{{ "%.1f"|format(row.points_for) }}</td><td>{{ "%.1f"|format(row.points_against) }}</td>
      <td>{{ row.standing }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <h2>Current Season Activity</h2>
  <div class="table-wrap">
  <table class="sortable">
    <thead>
      <tr>
        <th>Manager</th><th>Team</th><th>Best Game</th><th>Worst Game</th>
        <th>Longest Win Streak</th><th>Longest Loss Streak</th>
        <th>Acquisitions</th><th>Drops</th><th>Trades</th>
      </tr>
    </thead>
    <tbody>
    {% for row in current_season_activity %}
    <tr>
      <td>{{ row.manager_name }}</td><td>{{ row.team_name }}</td>
      <td data-sort="{{ row.best_game_score if row.best_game_score == row.best_game_score else -1 }}">
        {% if row.best_game_score == row.best_game_score %}{{ "%.1f"|format(row.best_game_score) }}<span class="cell-detail">Wk{{ row.best_game_week|int }}</span>{% else %}-{% endif %}
      </td>
      <td data-sort="{{ row.worst_game_score if row.worst_game_score == row.worst_game_score else -1 }}">
        {% if row.worst_game_score == row.worst_game_score %}{{ "%.1f"|format(row.worst_game_score) }}<span class="cell-detail">Wk{{ row.worst_game_week|int }}</span>{% else %}-{% endif %}
      </td>
      <td data-sort="{{ row.longest_win_streak }}">{{ row.longest_win_streak if row.longest_win_streak else "-" }}</td>
      <td data-sort="{{ row.longest_loss_streak }}">{{ row.longest_loss_streak if row.longest_loss_streak else "-" }}</td>
      <td>{{ row.acquisitions }}</td>
      <td>{{ row.drops }}</td><td>{{ row.trades }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
</div>

<div class="tab-panel" id="tab-alltime" role="tabpanel">
<section>
  <h2>All-Time Summary</h2>
  <div class="table-wrap">
  <table class="sortable">
    <thead>
    <tr>
      <th>Manager</th><th>Seasons</th><th>Playoffs</th><th>Titles</th><th>2nd</th>
      <th>W</th><th>L</th><th>T</th><th>Win%</th>
      <th>PF</th><th>PA</th><th>+/-</th>
    </tr>
    </thead>
    <tbody>
    {% for row in all_time %}
    <tr>
      <td>{{ row.manager_name }}</td><td>{{ row.seasons_played }}</td>
      <td>{{ row.playoff_appearances }}</td>
      <td>{{ row.championships }}</td><td>{{ row.runner_up_finishes }}</td>
      <td>{{ row.wins }}</td><td>{{ row.losses }}</td><td>{{ row.ties }}</td>
      <td>{{ "%.1f"|format(row.win_pct * 100) }}%</td>
      <td>{{ "%.0f"|format(row.points_for) }}</td><td>{{ "%.0f"|format(row.points_against) }}</td>
      <td>{{ "%.0f"|format(row.point_diff) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
</div>

<div class="tab-panel" id="tab-regular" role="tabpanel">
<section>
  <h2>Regular Season (all-time)</h2>
  <div class="table-wrap">
  <table class="sortable">
    <thead>
      <tr><th>Manager</th><th>Games</th><th>W</th><th>L</th><th>T</th><th>Win%</th><th>PF</th><th>PA</th><th>Avg PF</th><th>Avg PA</th></tr>
    </thead>
    <tbody>
    {% for row in regular_season %}
    <tr>
      <td>{{ row.manager_name }}</td><td>{{ row.games }}</td>
      <td>{{ row.wins }}</td><td>{{ row.losses }}</td><td>{{ row.ties }}</td>
      <td>{{ "%.1f"|format(row.win_pct * 100) }}%</td>
      <td>{{ "%.1f"|format(row.points_for) }}</td><td>{{ "%.1f"|format(row.points_against) }}</td>
      <td>{{ "%.1f"|format(row.avg_points_for) }}</td><td>{{ "%.1f"|format(row.avg_points_against) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
</div>

<div class="tab-panel" id="tab-playoffs" role="tabpanel">
<section>
  <h2>Playoffs (all-time, real bracket only)</h2>
  <div class="table-wrap">
  <table class="sortable">
    <thead>
      <tr><th>Manager</th><th>Appearances</th><th>Titles</th><th>2nd Place</th><th>Byes</th><th>Games</th><th>W</th><th>L</th><th>T</th><th>Win%</th><th>PF</th><th>PA</th><th>Avg PF</th><th>Avg PA</th></tr>
    </thead>
    <tbody>
    {% for row in playoffs %}
    <tr>
      <td>{{ row.manager_name }}</td><td>{{ row.appearances }}</td><td>{{ row.championships }}</td><td>{{ row.runner_up_finishes }}</td><td>{{ row.bye_weeks }}</td><td>{{ row.games }}</td>
      <td>{{ row.wins }}</td><td>{{ row.losses }}</td><td>{{ row.ties }}</td>
      <td data-sort="{{ (row.win_pct * 100) if row.win_pct is not none else -1 }}">
        {% if row.win_pct is not none %}{{ "%.1f"|format(row.win_pct * 100) }}%{% else %}n/a{% endif %}
      </td>
      <td>{{ "%.1f"|format(row.points_for) }}</td><td>{{ "%.1f"|format(row.points_against) }}</td>
      <td>{{ "%.1f"|format(row.avg_points_for) }}</td><td>{{ "%.1f"|format(row.avg_points_against) }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
</div>

<div class="tab-panel" id="tab-charts" role="tabpanel">
<section>
  <h2>Charts</h2>
  <div class="charts-grid">
    <div class="chart-box"><canvas id="pointsTrend"></canvas></div>
    <div class="chart-box"><canvas id="championships"></canvas></div>
    <div class="chart-box"><canvas id="winPct"></canvas></div>
    <div class="chart-box"><canvas id="pfPa"></canvas></div>
    <div class="chart-box"><canvas id="standingsOverTime"></canvas></div>
    <div class="chart-box"><canvas id="playoffsChart"></canvas></div>
    <div class="chart-box"><canvas id="pointsCumulative"></canvas></div>
    <div class="chart-box"><canvas id="winsCumulative"></canvas></div>
  </div>
</section>
</div>

<div class="tab-panel" id="tab-h2h" role="tabpanel">
<section>
  <h2>Head-to-Head (all-time)</h2>
  <div class="table-wrap">
  <table class="h2h-table">
    <tr><th class="h2h-corner"><span class="h2h-corner-opponent">Opponent</span><span class="h2h-corner-manager">Manager</span></th>{% for m in h2h_managers %}<th>{{ m }}</th>{% endfor %}</tr>
    {% for row_manager in h2h_managers %}
    <tr>
      <th>{{ row_manager }}</th>
      {% for col_manager in h2h_managers %}
        {% set cell = h2h_cells[row_manager][col_manager] %}
        {% if row_manager == col_manager %}
          <td>-</td>
        {% elif cell %}
          <td style="background-color: {{ cell.color }};">
            {{ cell.wins }}-{{ cell.losses }}{% if cell.ties %}-{{ cell.ties }}{% endif %}
          </td>
        {% else %}
          <td>-</td>
        {% endif %}
      {% endfor %}
    </tr>
    {% endfor %}
  </table>
  </div>
</section>
</div>

<div class="tab-panel" id="tab-byseason" role="tabpanel">
<section>
  <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
    <h2 style="margin: 0;">Results By Season</h2>
    <select id="season-sort" aria-label="Sort all season tables" style="max-width: 100%; min-height: 44px;">
      <option value="">Sort all seasons</option>
      {% for column, name in [(0, 'Manager'), (1, 'Team'), (2, 'Wins'), (3, 'Losses'), (4, 'Ties'), (5, 'Points For'), (6, 'Points Against'), (7, 'Reg Season Finish'), (8, 'Final Standing'), (9, 'Made Playoffs')] %}
      {% set is_standing = column in (7, 8) %}
      {% set is_name = column < 2 %}
      <optgroup label="{{ name }}">
      {% if is_standing %}
        <option value="{{ column }}:asc">Best to Worst</option>
        <option value="{{ column }}:desc">Worst to Best</option>
      {% elif is_name %}
        <option value="{{ column }}:asc">A to Z</option>
        <option value="{{ column }}:desc">Z to A</option>
      {% else %}
        <option value="{{ column }}:desc">High to Low</option>
        <option value="{{ column }}:asc">Low to High</option>
      {% endif %}
      </optgroup>
      {% endfor %}
    </select>
    <button id="season-sort-refresh" type="button" title="Reapply selected sort to all seasons" aria-label="Reapply selected sort to all seasons"><span class="refresh-arrow" aria-hidden="true">&#8635;</span><span class="refresh-label">refresh</span></button>
  </div>
  {% for group in season_groups %}
  <h3>{{ group.year }}</h3>
  <div class="table-wrap">
  <table class="sortable">
    <thead>
      <tr>
        <th>Manager</th><th>Team</th><th>W</th><th>L</th><th>T</th>
        <th>PF</th><th>PA</th><th>Reg Season Finish</th><th>Final Standing</th><th>Made Playoffs</th>
      </tr>
    </thead>
    <tbody>
    {% for row in group.rows %}
    <tr class="{% if row.final_standing == 1 %}finish-gold{% elif row.final_standing == 2 %}finish-silver{% endif %}">
      <td>{{ row.manager_name }}</td><td>{{ row.team_name }}</td>
      <td>{{ row.wins }}</td><td>{{ row.losses }}</td><td>{{ row.ties }}</td>
      <td>{{ "%.1f"|format(row.points_for) }}</td><td>{{ "%.1f"|format(row.points_against) }}</td>
      <td data-sort="{{ row.standing if row.standing else 99 }}">{{ row.standing if row.standing else "-" }}</td>
      <td data-sort="{{ row.final_standing if row.final_standing else 99 }}"{% if row.final_standing == 1 %} title="Champion"{% elif row.final_standing == 2 %} title="Runner-up"{% endif %}>
        {{ row.final_standing if row.final_standing else "-" }}
      </td>
      <td data-sort="{{ 1 if row.made_playoffs else 0 }}">{{ "Yes" if row.made_playoffs else "No" }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  {% endfor %}
</section>
</div>

<div class="tab-panel" id="tab-misc" role="tabpanel">
<section>
  <h2>Misc</h2>
  <div class="table-wrap">
  <table class="sortable">
    <thead>
      <tr>
        <th>Manager</th><th>Best Season PF</th><th>Worst Season PF</th><th>Best Game</th><th>Worst Game</th>
        <th>Longest Win Streak</th><th>Longest Loss Streak</th>
        <th>Acquisitions</th><th>Acquisitions per Season</th><th>Drops</th><th>Trades</th>
      </tr>
    </thead>
    <tbody>
    {% for row in all_time %}
    <tr>
      <td>{{ row.manager_name }}</td>
      <td data-sort="{{ row.best_season_points }}">
        {{ "%.1f"|format(row.best_season_points) }}<span class="cell-detail">{{ "%.0f"|format(row.best_season_points_year) }}</span>
      </td>
      <td data-sort="{{ row.worst_season_points }}">
        {% if row.worst_season_points == row.worst_season_points %}
        {{ "%.1f"|format(row.worst_season_points) }}<span class="cell-detail">{{ "%.0f"|format(row.worst_season_points_year) }}</span>
        {% else %}-{% endif %}
      </td>
      <td data-sort="{{ row.best_game_score }}">
        {{ "%.1f"|format(row.best_game_score) }}<span class="cell-detail">{{ row.best_game_year }} Wk{{ row.best_game_week }}</span>
      </td>
      <td data-sort="{{ row.worst_game_score }}">
        {{ "%.1f"|format(row.worst_game_score) }}<span class="cell-detail">{{ row.worst_game_year }} Wk{{ row.worst_game_week }}</span>
      </td>
      <td data-sort="{{ row.longest_win_streak }}">
        {% if row.longest_win_streak %}{{ row.longest_win_streak }}<span class="cell-detail">{{ row.longest_win_streak_span[0] }}{% if row.longest_win_streak_span[0] != row.longest_win_streak_span[1] %}-{{ row.longest_win_streak_span[1] }}{% endif %}</span>{% else %}-{% endif %}
      </td>
      <td data-sort="{{ row.longest_loss_streak }}">
        {% if row.longest_loss_streak %}{{ row.longest_loss_streak }}<span class="cell-detail">{{ row.longest_loss_streak_span[0] }}{% if row.longest_loss_streak_span[0] != row.longest_loss_streak_span[1] %}-{{ row.longest_loss_streak_span[1] }}{% endif %}</span>{% else %}-{% endif %}
      </td>
      <td>{{ row.acquisitions }}</td>
      <td>{{ "%.1f"|format(row.acquisitions_per_season) }}</td>
      <td>{{ row.drops }}</td><td>{{ row.trades }}</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</section>
</div>
</div>
</div>

{% if mobile_test %}
<script>
document.querySelectorAll("table").forEach((table) => {
  const headers = Array.from(table.rows[0].cells).map((cell) => cell.textContent.trim());
  Array.from(table.rows).slice(1).forEach((row) => {
    Array.from(row.cells).forEach((cell, index) => {
      if (cell.tagName === "TD") cell.dataset.label = headers[index];
    });
  });
});
</script>
{% endif %}
<script>
const CHARTS = {{ charts_json|safe }};
const palette = ["#4cc9f0","#f72585","#ffd60a","#06d6a0","#ff6b35","#9d4edd","#e63946","#1b998b","#ffffff"];

function colorize(datasets) {
  return datasets.map((d, i) => ({...d, borderColor: palette[i % palette.length], backgroundColor: palette[i % palette.length]}));
}

const allCharts = [];
if (typeof Chart !== "undefined") {
try {
Chart.defaults.color = "#cbd5e1";
Chart.defaults.borderColor = "#334155";
Chart.defaults.plugins.legend.labels.color = "#e2e8f0";
allCharts.push(new Chart(document.getElementById('pointsTrend'), {
  type: 'line',
  data: { labels: CHARTS.points_trend.labels, datasets: colorize(CHARTS.points_trend.datasets).map(d => ({...d, fill: false})) },
  options: { plugins: { title: { display: true, text: 'Points Per Season', color: '#e2e8f0' } } }
}));

allCharts.push(new Chart(document.getElementById('championships'), {
  type: 'bar',
  data: { labels: CHARTS.championships.labels, datasets: [{ label: 'Championships', data: CHARTS.championships.values, backgroundColor: palette[0] }] },
  options: { plugins: { title: { display: true, text: 'Championships', color: '#e2e8f0' } } }
}));

allCharts.push(new Chart(document.getElementById('winPct'), {
  type: 'bar',
  data: { labels: CHARTS.win_pct.labels, datasets: [{ label: 'Win %', data: CHARTS.win_pct.values, backgroundColor: palette[1] }] },
  options: { scales: { y: { suggestedMax: 100, title: { display: true, text: '%' } } },
             plugins: { title: { display: true, text: 'All-Time Win %', color: '#e2e8f0' } } }
}));

allCharts.push(new Chart(document.getElementById('pfPa'), {
  type: 'bar',
  data: { labels: CHARTS.pf_pa.labels, datasets: [
    { label: 'Avg Points For', data: CHARTS.pf_pa.points_for, backgroundColor: palette[3] },
    { label: 'Avg Points Against', data: CHARTS.pf_pa.points_against, backgroundColor: palette[6] }
  ]},
  options: { plugins: { title: { display: true, text: 'Avg Points For vs Against', color: '#e2e8f0' } } }
}));

allCharts.push(new Chart(document.getElementById('standingsOverTime'), {
  type: 'line',
  data: { labels: CHARTS.standings_over_time.labels, datasets: colorize(CHARTS.standings_over_time.datasets).map(d => ({...d, fill: false, spanGaps: true})) },
  options: { scales: { y: { reverse: true, title: { display: true, text: 'Final Standing (1 = best)' } } },
             plugins: { title: { display: true, text: 'Standings Over Time', color: '#e2e8f0' } } }
}));

allCharts.push(new Chart(document.getElementById('playoffsChart'), {
  type: 'bar',
  data: { labels: CHARTS.playoffs.labels, datasets: [
    { label: 'Playoff Appearances', data: CHARTS.playoffs.appearances, backgroundColor: palette[4] },
    { label: 'Playoff Win %', data: CHARTS.playoffs.win_pct, backgroundColor: palette[5] }
  ]},
  options: { plugins: { title: { display: true, text: 'Playoff Appearances & Win % (right axis is % for wins)', color: '#e2e8f0' } } }
}));
for (const [canvasId, seriesKey, title, unit] of [
  ['pointsCumulative', 'points_cumulative', 'Total Points Over Time', 'Career Points'],
  ['winsCumulative', 'wins_cumulative', 'Total Wins Over Time', 'Career Wins']
]) {
  const series = CHARTS[seriesKey];
  allCharts.push(new Chart(document.getElementById(canvasId), {
    type: 'line',
    data: { labels: series.labels, datasets: colorize(series.datasets).map(dataset => ({...dataset, fill: false})) },
    options: {
      interaction: { mode: 'index', intersect: false },
      scales: { x: { title: { display: true, text: 'Season' } }, y: { beginAtZero: true, title: { display: true, text: unit } } },
      plugins: { title: { display: true, text: title, color: '#e2e8f0' } }
    }
  }));
}
} catch (err) {
  console.warn("Chart rendering failed; tabs and tables remain available:", err);
}
} else {
  console.warn("Chart.js is unavailable; tabs and tables remain available.");
}

const chartsTab = document.getElementById("tab-charts-choice");
if (chartsTab) {
  chartsTab.addEventListener("change", () => {
    window.requestAnimationFrame(() => allCharts.forEach((chart) => chart.resize()));
  });
}

// Generic click-to-sort for any <table class="sortable"> with a <thead>/<tbody>.
function cellSortValue(td) {
  return td.dataset.sort !== undefined ? td.dataset.sort : td.textContent.trim();
}

function sortTableByColumn(table, colIndex, ascending) {
  const tbody = table.tBodies[0];
  const rows = Array.from(tbody.rows);
  const allNumeric = rows.every((r) => {
    const v = cellSortValue(r.cells[colIndex]);
    return v !== "" && !isNaN(parseFloat(v));
  });
  const headerCells = Array.from(table.tHead.rows[0].cells);
  const pfColIndex = headerCells.findIndex((th) => th.textContent.trim().toUpperCase() === "PF");
  const pfIsNumeric = pfColIndex >= 0 && rows.every((r) => {
    const v = cellSortValue(r.cells[pfColIndex]);
    return v !== "" && !isNaN(parseFloat(v));
  });
  rows.sort((a, b) => {
    let va = cellSortValue(a.cells[colIndex]);
    let vb = cellSortValue(b.cells[colIndex]);
    if (allNumeric) {
      va = parseFloat(va);
      vb = parseFloat(vb);
    } else {
      va = va.toLowerCase();
      vb = vb.toLowerCase();
    }
    if (va < vb) return ascending ? -1 : 1;
    if (va > vb) return ascending ? 1 : -1;
    // Tie on the sorted column: fall back to PF in the same direction as the primary sort.
    if (pfIsNumeric && pfColIndex !== colIndex) {
      const pfA = parseFloat(cellSortValue(a.cells[pfColIndex]));
      const pfB = parseFloat(cellSortValue(b.cells[pfColIndex]));
      if (pfA !== pfB) return ascending ? pfA - pfB : pfB - pfA;
    }
    return 0;
  });
  rows.forEach((r) => tbody.appendChild(r));
}

function applySortToTable(table, colIndex, ascending) {
  const headerCells = Array.from(table.tHead.rows[0].cells);
  headerCells.forEach((h) => {
    delete h.dataset.sortDir;
    const existing = h.querySelector(".sort-indicator");
    if (existing) existing.remove();
  });
  const th = headerCells[colIndex];
  th.dataset.sortDir = ascending ? "asc" : "desc";
  const indicator = document.createElement("span");
  indicator.className = "sort-indicator";
  indicator.textContent = ascending ? " \u25B2" : " \u25BC";
  (th.querySelector("button.sort-btn") || th).appendChild(indicator);
  sortTableByColumn(table, colIndex, ascending);
}

// iOS Safari often ignores taps on bare <th>/<td> elements; wrap header text in a
// real <button> so taps register reliably.
function wrapHeaderButton(th) {
  let btn = th.querySelector("button.sort-btn");
  if (btn) return btn;
  const label = th.textContent.trim();
  th.textContent = "";
  btn = document.createElement("button");
  btn.type = "button";
  btn.className = "sort-btn";
  btn.textContent = label;
  btn.setAttribute("aria-label", "Sort by " + label);
  th.appendChild(btn);
  return btn;
}

function applySeasonSort() {
  const value = document.getElementById("season-sort").value;
  if (!value) return;
  const [column, direction] = value.split(":");
  document.querySelectorAll("#tab-byseason table.sortable").forEach((table) => {
    applySortToTable(table, Number(column), direction === "asc");
  });
}

document.getElementById("season-sort").addEventListener("change", applySeasonSort);
document.getElementById("season-sort-refresh").addEventListener("click", applySeasonSort);

document.querySelectorAll("table.sortable").forEach((table) => {
  const headerCells = Array.from(table.tHead.rows[0].cells);
  headerCells.forEach((th, colIndex) => {
    const btn = wrapHeaderButton(th);
    btn.addEventListener("click", () => {
      // First click on a column always sorts high-to-low (best to worst); click again to flip.
      const ascending = th.dataset.sortDir === "desc";
      applySortToTable(table, colIndex, ascending);
    });
  });
});
</script>
</body>
</html>
